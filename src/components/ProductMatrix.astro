---
import ArrowIcon from "./ArrowIcon.astro";
import NetworkLine from "./visuals/NetworkLine.astro";
import {
  home,
  productPath,
  products,
  shared,
  type Locale,
} from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = shared[locale];
const homeCopy = home[locale];
const openAcad = products.openacad[locale];
const openTrad = products.opentrad[locale];
const openVac = products.openvac[locale];
const starNexus = products["star-nexus"][locale];
---

<section class="product-section page-shell section-rule" id="products">
  <div class="section-heading section-heading--split">
    <h2>{homeCopy.productsTitle}</h2>
    <p>{homeCopy.productsIntro}</p>
  </div>

  <div class="product-matrix">
    <article class="product-panel product-panel--acad">
      <div class="product-panel__heading">
        <div>
          <p class="stage-label">
            <span></span>{copy.stages[openAcad.stage]}
          </p>
          <h3>{openAcad.name}</h3>
        </div>
        <a
          class="text-link"
          href={productPath(locale, openAcad.slug)}
          aria-label={`${copy.common.learnMore}: ${openAcad.name}`}
        >
          <span>{copy.common.learnMore}</span>
          <ArrowIcon />
        </a>
      </div>
      <p class="product-panel__summary">{openAcad.summary}</p>
      <div class="product-panel__media product-panel__media--screenshot">
        <img
          src="/assets/products/paperbanana-desktop.jpg"
          alt={openAcad.imageAlt}
          width="1440"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>

    <article class="product-panel product-panel--trad">
      <div class="product-panel__heading">
        <div>
          <p class="stage-label">
            <span></span>{copy.stages[openTrad.stage]}
          </p>
          <h3>{openTrad.name}</h3>
        </div>
        <a
          class="icon-link"
          href={productPath(locale, openTrad.slug)}
          aria-label={`${copy.common.learnMore}: ${openTrad.name}`}
        >
          <ArrowIcon />
        </a>
      </div>
      <p class="product-panel__summary">{openTrad.summary}</p>
      <svg class="matrix-trade-visual" viewBox="0 0 400 185" aria-hidden="true">
        <path class="matrix-trade-visual__base" d="M16 118C62 70 106 67 146 88s75 11 109-15 69-18 98 7 26 24 36 19" />
        <path class="matrix-trade-visual__line" d="M44 113L132 55L230 97L332 45L374 104M44 113L174 151L230 97L340 143" />
        <g>
          <circle cx="44" cy="113" r="5" />
          <circle cx="132" cy="55" r="4" />
          <circle cx="174" cy="151" r="4" />
          <circle cx="230" cy="97" r="6" />
          <circle cx="332" cy="45" r="4" />
          <circle cx="340" cy="143" r="4" />
          <circle cx="374" cy="104" r="5" />
        </g>
      </svg>
    </article>

    <article class="product-panel product-panel--vac">
      <div class="product-panel__heading">
        <div>
          <p class="stage-label">
            <span></span>{copy.stages[openVac.stage]}
          </p>
          <h3>{openVac.name}</h3>
        </div>
        <a
          class="icon-link"
          href={productPath(locale, openVac.slug)}
          aria-label={`${copy.common.learnMore}: ${openVac.name}`}
        >
          <ArrowIcon />
        </a>
      </div>
      <p class="product-panel__summary">{openVac.summary}</p>
      <figure class="product-panel__media product-panel__media--vacuum">
        <img
          src="/assets/products/openvac-scene.jpg"
          alt={openVac.imageAlt}
          width="1586"
          height="992"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{copy.common.sceneIllustration}</figcaption>
      </figure>
    </article>

    <article class="product-panel product-panel--nexus">
      <div class="product-panel__heading">
        <div>
          <p class="stage-label">
            <span></span>{copy.stages[starNexus.stage]}
          </p>
          <h3>{starNexus.name}</h3>
        </div>
        <a
          class="text-link"
          href={productPath(locale, starNexus.slug)}
          aria-label={`${copy.common.learnMore}: ${starNexus.name}`}
        >
          <span>{copy.common.learnMore}</span>
          <ArrowIcon />
        </a>
      </div>
      <div class="nexus-rail" aria-hidden="true">
        <span>{locale === "en" ? "Models" : "模型"}</span>
        <i></i>
        <span>{locale === "en" ? "Orchestration" : "调配"}</span>
        <i></i>
        <span>{locale === "en" ? "Collaboration" : "协作"}</span>
        <i></i>
        <span>{locale === "en" ? "Industry tools" : "行业工具"}</span>
      </div>
      <NetworkLine variant="rail" />
    </article>
  </div>
</section>
