---
import {
  CONTACT_EMAIL,
  pathFor,
  productOrder,
  productPath,
  products,
  shared,
  type Locale,
} from "../../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = shared[locale];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p>{copy.legalName}</p>
      <p>{copy.brand}</p>
      <p class="site-footer__line">{copy.footerLine}</p>
    </div>

    <div class="site-footer__group">
      <p class="site-footer__label">{copy.nav.products}</p>
      {
        productOrder.map((slug) => (
          <a href={productPath(locale, slug)}>{products[slug][locale].name}</a>
        ))
      }
    </div>

    <div class="site-footer__group">
      <p class="site-footer__label">
        {locale === "en" ? "Company" : "公司"}
      </p>
      <a href={pathFor(locale, "/careers/")}>{copy.nav.careers}</a>
      <a href={pathFor(locale, "/contact/")}>{copy.nav.contact}</a>
      <a href={pathFor(locale, "/privacy/")}>{copy.common.privacy}</a>
    </div>

    <div class="site-footer__group site-footer__contact">
      <p class="site-footer__label">{copy.common.directEmail}</p>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <span>yixingretail.cn</span>
    </div>
  </div>
  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} {copy.brand}</span>
    <span>{locale === "en" ? "Ningbo, China" : "中国 · 宁波"}</span>
  </div>
</footer>
